    <Style TargetType="TextBox"><Setter Property="Background" Value="#191C22"/><Setter Property="Foreground" Value="#F4F6FA"/><Setter Property="BorderBrush" Value="#485363"/><Setter Property="Padding" Value="12,10"/><Setter Property="CaretBrush" Value="#4FD5FF"/></Style>
